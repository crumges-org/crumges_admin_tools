<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="crumges_autogestion.Systray">
        <Dropdown state="dropdown" position="'bottom-end'" beforeOpen.bind="onToggle" menuClass="'o-crumges-ag-dropdown p-0'">
            <button class="o-crumges-ag-toggle position-relative" t-att-title="statusTitle" aria-label="Autogestión">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="7" rx="2"/><rect x="3" y="14" width="18" height="7" rx="2"/>
                    <path d="M7 6.5h.01M7 17.5h.01M11 6.5h6M11 17.5h6"/>
                </svg>
                <span t-if="status !== 'none'" t-attf-class="o-crumges-ag-dot o-crumges-ag-{{ status }}"/>
            </button>
            <t t-set-slot="content">
                <div class="o-crumges-ag">
                    <div class="o-crumges-ag-head">
                        <div>
                            <div class="o-crumges-ag-title">Autogestión</div>
                            <div class="o-crumges-ag-domain" t-if="state.data and state.data.domain" t-esc="state.data.domain"/>
                        </div>
                        <span t-if="state.data and state.data.reasons.length" t-attf-class="o-crumges-ag-badge o-crumges-ag-badge-{{ state.data.status }}">
                            <t t-esc="state.data.reasons.length"/> <t t-esc="state.data.reasons.length === 1 ? 'aviso' : 'avisos'"/>
                        </span>
                        <span t-elif="state.data" class="o-crumges-ag-badge o-crumges-ag-badge-ok">Todo en orden</span>
                    </div>

                    <div t-if="state.error" class="o-crumges-ag-error"><t t-esc="state.error"/></div>

                    <t t-if="state.data">
                        <div class="o-crumges-ag-res">
                            <div t-foreach="resources" t-as="r" t-key="r.key" class="o-crumges-ag-res-item">
                                <div class="o-crumges-ag-res-top">
                                    <span t-esc="r.label"/>
                                    <b t-attf-class="o-crumges-ag-txt-{{ r.level }}"><t t-esc="Math.round(r.percent)"/>%</b>
                                </div>
                                <div class="o-crumges-ag-bar"><div t-attf-class="o-crumges-ag-bg-{{ r.level }}" t-attf-style="width: {{ Math.min(100, r.percent) }}%"/></div>
                            </div>
                        </div>

                        <div class="o-crumges-ag-list">
                            <div t-foreach="state.data.instances" t-as="i" t-key="i.branch" class="o-crumges-ag-inst">
                                <span t-attf-class="o-crumges-ag-dot-inline {{ i.online ? 'o-crumges-ag-bg-ok' : 'o-crumges-ag-bg-off' }}"/>
                                <span class="o-crumges-ag-mono" t-esc="i.branch"/>
                                <i t-attf-class="fa {{ i.production ? 'fa-rocket' : 'fa-flask' }} o-crumges-ag-kind"/>
                                <span class="o-crumges-ag-detail" t-esc="instanceDetail(i)"/>
                            </div>
                        </div>

                        <div class="o-crumges-ag-alerts" t-if="state.data.alerts and state.data.alerts.items.length">
                            <div class="o-crumges-ag-label">ÚLTIMOS AVISOS</div>
                            <div t-foreach="state.data.alerts.items" t-as="a" t-key="a_index" class="o-crumges-ag-alert">
                                <span t-attf-class="o-crumges-ag-dot-inline o-crumges-ag-bg-{{ a.status === 'error' ? 'critical' : a.status === 'warning' ? 'warning' : 'ok' }}"/>
                                <span class="o-crumges-ag-alert-title" t-esc="a.title"/>
                                <span class="o-crumges-ag-detail" t-esc="ago(a.created_at)"/>
                            </div>
                        </div>
                        <div class="o-crumges-ag-hint" t-elif="!state.data.authenticated">
                            Ingresá para autogestionar tus ambientes, respaldos y más.
                        </div>
                    </t>
                    <div t-elif="!state.error and cfg.showStatus" class="o-crumges-ag-hint">Cargando…</div>

                    <div class="o-crumges-ag-foot">
                        <button class="btn o-crumges-ag-open" t-on-click="open">
                            <t t-if="state.data and !state.data.authenticated">Ingresar a Autogestión</t>
                            <t t-else="">Abrir Autogestión</t>
                            <i class="fa fa-external-link ms-2"/>
                        </button>
                    </div>
                </div>
            </t>
        </Dropdown>
    </t>
</templates>
