<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.crumges.autogestion</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='about_setting_container']" position="before">
                    <block title="Crumges Autogestión" name="crumges_autogestion_block" groups="base.group_system">
                        <setting string="Dirección de Autogestión" help="Panel de gestión del servidor. Lo ven los usuarios con el permiso Autogestión / Usuario.">
                            <field name="crumges_autogestion_url" placeholder="/autogestion/"/>
                        </setting>
                        <setting help="El ícono de la barra muestra recursos, instancias y respaldos. Requiere que Autogestión esté en el mismo dominio que este Odoo.">
                            <field name="crumges_autogestion_show_status"/>
                        </setting>
                    </block>
            </xpath>
        </field>
    </record>
</odoo>
