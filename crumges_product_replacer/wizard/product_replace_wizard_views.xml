<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_replace_wizard_form" model="ir.ui.view">
        <field name="name">product.replace.wizard.form</field>
        <field name="model">product.replace.wizard</field>
        <field name="groups_id" eval="[(4, ref('base.group_no_one'))]"/>
        <field name="arch" type="xml">
            <form string="Fusión Quirúrgica de Productos">
                <div class="alert alert-danger" role="alert">
                    <b>¡ATENCIÓN! HERRAMIENTA DESTRUCTIVA</b><br/>
                    Esta acción tomará todo el historial transaccional del Producto Origen (pedidos, facturas, movimientos de stock, valoración) y se lo traspasará al Producto Destino mediante sentencias SQL crudas, evadiendo las reglas de Odoo.<br/>
                    <br/>
                    <b>ADVERTENCIA DE STOCK:</b> Asegúrate de que el Producto Destino es <b>COMPLETAMENTE NUEVO</b> y no tiene cantidades a mano. Si ambos productos tienen cantidades en la misma ubicación, la base de datos podría rechazar la operación por clave duplicada en los Quants.
                </div>
                
                <group>
                    <field name="old_product_id" options="{'no_create': True}"/>
                    <field name="new_product_id" options="{'no_create': True}"/>
                </group>
                <group>
                    <field name="update_uom"/>
                    <field name="archive_old"/>
                </group>
                <footer>
                    <button name="action_apply_replace" string="Ejecutar Fusión SQL" type="object" class="btn-danger" confirm="¿Estás completamente seguro de fusionar el historial de estos productos? Esta acción no se puede deshacer."/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_replace_wizard" model="ir.actions.act_window">
        <field name="name">Reemplazo Quirúrgico de Productos</field>
        <field name="res_model">product.replace.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('base.group_no_one'))]"/>
    </record>

    <!-- Lo inyectamos en el menú de Acción del producto -->
    <record id="action_product_replace_wizard_binding" model="ir.actions.act_window">
        <field name="name">Reemplazo Quirúrgico de Productos</field>
        <field name="res_model">product.replace.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="groups_id" eval="[(4, ref('base.group_no_one'))]"/>
    </record>

    <!-- Opcionalmente, lo inyectamos también en la plantilla del producto -->
    <record id="action_product_template_replace_wizard_binding" model="ir.actions.act_window">
        <field name="name">Reemplazo Quirúrgico de Productos</field>
        <field name="res_model">product.replace.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="groups_id" eval="[(4, ref('base.group_no_one'))]"/>
    </record>
</odoo>
