<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_inherit_direct_payment" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.direct.payment</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <!-- Agregamos el switch en la pestaña de asientos contables -->
            <xpath expr="//field[@name='default_account_id']" position="after">
                <field name="crumges_direct_payment" widget="boolean_toggle" invisible="type not in ('bank', 'cash', 'credit')"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_journal_tree_inherit_direct_payment" model="ir.ui.view">
        <field name="name">account.journal.tree.inherit.direct.payment</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="crumges_direct_payment" widget="boolean_toggle" invisible="type not in ('bank', 'cash', 'credit')" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
