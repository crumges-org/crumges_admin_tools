<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Formulario del Wizard -->
    <record id="view_journal_resequence_wizard_form" model="ir.ui.view">
        <field name="name">journal.resequence.wizard.form</field>
        <field name="model">journal.resequence.wizard</field>
        <field name="arch" type="xml">
            <form string="Resecuenciar Diario">
                <div class="alert alert-warning" role="alert">
                    <strong>¡Atención!</strong> Esta es una acción avanzada y destructiva. Alterará directamente la base de datos para reescribir la secuencia contable de los asientos de este diario.
                </div>
                <group>
                    <field name="journal_id"/>
                    <field name="old_code"/>
                    <field name="new_code"/>
                </group>
                <footer>
                    <button name="action_apply_resequence" string="Forzar Resecuenciación" type="object" class="btn-danger"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción de Ventana para el Wizard -->
    <record id="action_journal_resequence_wizard" model="ir.actions.act_window">
        <field name="name">Forzar Cambio de Código Corto</field>
        <field name="res_model">journal.resequence.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_journal_id': active_id}</field>
        <field name="binding_model_id" ref="account.model_account_journal"/>
        <!-- Solo desarrolladores/superusuarios pueden ver esta acción -->
        <field name="groups_id" eval="[(4, ref('base.group_no_one'))]"/>
    </record>
</odoo>
